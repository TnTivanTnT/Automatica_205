    <Action Name="RotArray" Id="{d2258d71-d1ae-43c7-b4d8-bc3edbd917ec}">
      <Implementation>
        <ST><![CDATA[TapaAuxRot := Tapas[7];
Tapas[7] := Tapas[6];
Tapas[6] := Tapas[5];
Tapas[5] := Tapas[4];
Tapas[4] := Tapas[3];
Tapas[3] := Tapas[2];
Tapas[2] := Tapas[1];
Tapas[1] := Tapas[0];
Tapas[0] := TapaAuxRot;
]]></ST>
      </Implementation>
    </Action>
    <Action Name="S0_entry" Id="{faf887e1-7e8f-4007-868f-2b755c57d673}">
      <Implementation>
        <ST><![CDATA[cont := 0;
Tapas[0].Ocupada := 0;
Tapas[1].Ocupada := 0;
Tapas[2].Ocupada := 0;
Tapas[3].Ocupada := 0;
Tapas[4].Ocupada := 0;
Tapas[5].Ocupada := 0;
Tapas[6].Ocupada := 0;
Tapas[7].Ocupada := 0;]]></ST>
      </Implementation>
    </Action>
    <Action Name="S160_exit" Id="{364aa1c2-2031-4277-9c42-436897932e92}">
      <Implementation>
        <ST><![CDATA[Tapas[2].Tapa.Alta := (MedidorAltura <= 1300);
Tapas[3].Tapa.Clara := DetectorFotoelectrico;
Tapas[4].Tapa.Metalica := DetectorInductivo;
]]></ST>
      </Implementation>
    </Action>
    <Action Name="S171_entry" Id="{518da548-90d4-42bd-8d42-0e0def533d09}">
      <Implementation>
        <ST><![CDATA[]]></ST>
      </Implementation>
    </Action>
    <Action Name="S176_exit" Id="{a8a65394-50d3-4c9d-8346-fde83d0b8e2e}">
      <Implementation>
        <ST><![CDATA[cont := cont + 1;]]></ST>
      </Implementation>
    </Action>
    <Action Name="S85_exit" Id="{c47f20e4-f986-407c-a5ec-7ebd72460b11}">
      <Implementation>
        <ST><![CDATA[Tapas[0].Ocupada := TRUE;
]]></ST>
      </Implementation>
    </Action>
