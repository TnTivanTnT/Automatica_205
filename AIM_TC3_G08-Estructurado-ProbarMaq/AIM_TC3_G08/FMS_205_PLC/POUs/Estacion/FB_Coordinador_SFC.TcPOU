<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.12">
  <POU Name="FB_Coordinador_SFC" Id="{8281f6e9-331f-40c9-b896-41f2f2d0b403}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_Coordinador_SFC

VAR_INPUT
    SFCPause: BOOL;
    SFCReset: BOOL;
    
    // Indicadores de sincronizacion
    Benido: BOOL := TRUE;
    Ejecuta: BOOL;
    
    // Indicadores de control
    Resume: BOOL;
    StepByStep: BOOL;
    
    // Parametros de sincronizacion
    PaleSituado: BOOL;
    Alimentado: BOOL;
    Cargado: BOOL;
    Girado: BOOL;
    Medido: BOOL;
    Rechazada: BOOL;
    Descargada: BOOL;
    Transferido: BOOL;
    
    
    // Parametros
    CondicionInicial: BOOL;
    UnidadesSolicitadas: UINT;
    
    Tapas : ARRAY[0..7] OF ST_POSICION;
    //TapaAuxRot : ST_POSICION; 
    //CLK: FB_Clock;
    
    TapaDeseada : ST_TAPA;
    //NumPiezasDes: UINT;
    cont: UINT;
    
END_VAR

VAR_OUTPUT
    Acabhe: BOOL;
    ListoKalisto: BOOL;
    
    // Parametros de sincronizacion
    SituaPale: BOOL;
    Alimenta: BOOL;
    Carga: BOOL;
    Gira: BOOL;
    Mide: BOOL;
    Descarga: BOOL;
    Rechaza: BOOL;
    Transfiere : BOOL;
    
    
    // Salidas
     LamparaAlarma: BOOL;
    LamparaMarcha: BOOL;
END_VAR
   
VAR_IN_OUT
   
END_VAR

VAR
     // Bloques funcionales
    CLK: FB_Clock;
    Deseada : BOOL;
    Eliminada : BOOL; 
END_VAR
]]></Declaration>
