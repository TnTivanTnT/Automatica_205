    <Action Name="Init_entry" Id="{b24d784b-b2a2-4993-8844-fd421696650b}">
      <Implementation>
        <ST><![CDATA[
Tapas[0].Ocupada := 0;
Tapas[1].Ocupada := 0;
Tapas[2].Ocupada := 0;
Tapas[3].Ocupada := 0;
Tapas[4].Ocupada := 0;
Tapas[5].Ocupada := 0;
Tapas[6].Ocupada := 0;
Tapas[7].Ocupada := 0;]]></ST>
      </Implementation>
    </Action>
    <Action Name="S10_exit" Id="{dfc64b29-8306-4ec4-a33d-02f6403a530f}">
      <Implementation>
        <ST><![CDATA[]]></ST>
      </Implementation>
    </Action>
    <Action Name="S70_entry" Id="{7c93b1b9-da26-4bbc-b082-365743a32e80}">
      <Implementation>
        <ST><![CDATA[Deseada := (Tapas[7].Ocupada AND Tapas[7].Tapa.Alta = TapaDeseada.Alta AND Tapas[7].Tapa.Clara = TapaDeseada.Clara AND Tapas[7].Tapa.Metalica = TapaDeseada.Metalica);

Eliminada := (Tapas[6].Ocupada AND NOT(Tapas[6].Tapa.Alta = TapaDeseada.Alta AND Tapas[6].Tapa.Clara = TapaDeseada.Clara AND Tapas[6].Tapa.Metalica = TapaDeseada.Metalica));]]></ST>
      </Implementation>
    </Action>
